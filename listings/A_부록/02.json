{
  "permissions": {
    "allow": [
      "Read", "Edit(src/**)",
      "Bash(npm run *)", "Bash(npx tsc *)",
      "Bash(git add *)", "Bash(git commit *)"
    ],
    "deny": ["Bash(npm publish *)"]
  },
  "hooks": {
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "npm run typecheck"
      }]
    }]
  }
}
